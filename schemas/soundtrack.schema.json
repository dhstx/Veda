{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Veda soundtrack family",
  "description": "One synchronized loop family for Prototype 0.1. Runtime validation additionally checks WAV format, exact frame counts, all layer ids, and the decoded memory budget.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "title", "tempoBpm", "beatsPerBar", "loopBars", "sampleRate", "channels", "layers", "states"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "id": { "type": "string", "minLength": 1 },
    "title": { "type": "string", "minLength": 1 },
    "tempoBpm": { "type": "number", "minimum": 40, "maximum": 240 },
    "beatsPerBar": { "type": "integer", "minimum": 1, "maximum": 12 },
    "loopBars": { "type": "integer", "minimum": 1, "maximum": 64 },
    "sampleRate": { "const": 48000 },
    "channels": { "const": 2 },
    "layers": {
      "type": "array", "minItems": 1, "maxItems": 8,
      "items": {
        "type": "object", "additionalProperties": false, "required": ["id", "file"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "file": { "type": "string", "minLength": 5, "pattern": "\\.[wW][aA][vV]$" }
        }
      }
    },
    "states": {
      "type": "object", "additionalProperties": false,
      "required": ["CalmSpace", "Travel", "Uncertain", "Combat", "Escape", "Relief"],
      "properties": {
        "CalmSpace": { "$ref": "#/$defs/gains" },
        "Travel": { "$ref": "#/$defs/gains" },
        "Uncertain": { "$ref": "#/$defs/gains" },
        "Combat": { "$ref": "#/$defs/gains" },
        "Escape": { "$ref": "#/$defs/gains" },
        "Relief": { "$ref": "#/$defs/gains" }
      }
    }
  },
  "$defs": {
    "gains": {
      "type": "object", "minProperties": 1, "maxProperties": 8,
      "additionalProperties": { "type": "number", "minimum": 0, "maximum": 1 }
    }
  }
}
